# Variables leídas por docker-compose.yml (distintas de backend/.env,
# que trae los secretos propios de la app: JWT_SECRET, WEATHER_API_KEY).
# Copia este archivo a ".env" en la raíz del proyecto y ajusta los valores.

# Credenciales de PostgreSQL (contenedor "db").
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=proyecto2

# Orígenes CORS del backend. Con el nginx del frontend haciendo de proxy de
# /api/*, casi todo el tráfico es same-origin; solo importa si accedes al
# backend desde otro origen.
CORS_ORIGINS=http://localhost

# Puerto del host que expone el frontend (nginx). 80 = puerto web estándar.
FRONTEND_PORT=80
