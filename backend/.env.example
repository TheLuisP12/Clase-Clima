# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# NUNCA subas el archivo ".env" real a control de versiones.

# Cadena de conexión a PostgreSQL.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/proyecto2

# Secreto usado para firmar los JWT. Usa un valor largo y aleatorio en producción,
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS (separados por coma). Debe incluir el origen
# del frontend en desarrollo (Vite).
CORS_ORIGINS=http://localhost:5173
